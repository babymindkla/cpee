#include <stdio.h>
#include <stdlib.h>
void display(int **);
int CheckandMove(int, int **);
int complete(int **);

void display(int **a) { /*เขียนฟังก์ชันเพื่อแสดงตารางปัจจุบัน*/
  printf(" ----- ----- ----- -----\n");
  for (int i = 0; i < 4; i++) {
    for (int j = 0; j < 4; j++) {
      if (a[i][j] == 0) {
        printf("|     ");
      } else {
        printf("|  %-2d ", a[i][j]);
      }
    }
    printf("|");
    printf("\n ----- ----- ----- -----\n");
  }
} //เสร็จแล้ว

int CheckandMove(int b, int **a) {
  /*เขียนฟังก์ชันเพื่อทำการตรวจสอบว่า input ดังกล่าว สามารถขยับได้หรือไม่*/
  int row, col, found = 0;

  for (int i = 0; i < 4; i++) {
    for (int j = 0; j < 4; j++) {
      if (a[i][j] == b) {
        row = i;
        col = j;
        found = 1;
        break;
      }
    }
    if (found)
      break;
  }
  if (!found)
    return 0;

  if (col > 0 && a[row][col - 1] == 0) {
    a[row][col - 1] = a[row][col];
    a[row][col] = 0;
    return 1;
  } else if (col < 3 && a[row][col + 1] == 0) {
    a[row][col + 1] = a[row][col];
    a[row][col] = 0;
    return 1;
  } else if (row > 0 && a[row - 1][col] == 0) {
    a[row - 1][col] = a[row][col];
    a[row][col] = 0;
    return 1;
  } else if (row < 3 && a[row + 1][col] == 0) {
    a[row + 1][col] = a[row][col];
    a[row][col] = 0;
    return 1;
  } else
    return 0;

} //เสร็จแล้ว

int complete(int **a) {

  /*เขียนฟังก์ชันเพื่อตรวจสอบว่าเลขเรียงถูกต้องหรือยัง*/
  int i, j, x = 0, **c;
  /*ทำการจองพื้นที่หน่วยความจำสำหรับตัวแปร c*/
  c = (int **)malloc(4 * sizeof(int *));
  for (i = 0; i < 4; i++) {
    c[i] = (int *)malloc(4 * sizeof(int));
  }

  c[0][0] = 1;
  c[0][1] = 2;
  c[0][2] = 3;
  c[0][3] = 4;
  c[1][0] = 5;
  c[1][1] = 6;
  c[1][2] = 7;
  c[1][3] = 8;
  c[2][0] = 9;
  c[2][1] = 10;
  c[2][2] = 11;
  c[2][3] = 12;
  c[3][0] = 13;
  c[3][1] = 14;
  c[3][2] = 15;
  c[3][3] = 0;

  for (i = 0; i < 4; i++) {
    for (j = 0; j < 4; j++) {
      if (a[i][j] != c[i][j])
        x = 1;
    }
  }
  for (int i = 0; i < 4; i++) {
    free(c[i]);
  }
  free(c);

  if (x == 0) {
    return 1;
  } else {
    return 0;
  }

} //เสร็จแล้ว

