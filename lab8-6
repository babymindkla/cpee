      a[i][j] = 0;
  }
  for (i = 0; i < 4; i++) {
    for (j = 0, check = 1; j < 4; j++) {
      while (check) {
        check = 0;
        a[i][j] = rand() % 16;
        for (k = 0; k <= i; k++) {
          for (l = 0; (k == i && l < j) || (k < i && l < 4); l++)
            if (a[k][l] == a[i][j]) {
              check = 1;
              break;
            }
          if (check)
            break;
        }
      }
      check = 1;
    }
  }
  
  display(a);  printf("\n");
  while (1) {
    printf("Input number you want to move : ");

    if (scanf("%d", &b) != 1) {
      printf("Can't move your number\n");
      while (getchar() != '\n')
        ;
    } else if (b < 1 || b > 15) {
      if (b == 0) {
        printf("Exit.");
        break;
      }
      printf("Can't move your number\n");
    } else {
      if (CheckandMove(b, a)) {
        count++;
        printf("\n");
        display(a);
        if (complete(a)) {
          printf("Your move is %d times\n", count);
